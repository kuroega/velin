{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "Windows x64 MinGW Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "Windows x64 Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (portable libraries and tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos-release", "output": { "outputOnFailure": true } }
  ]
}
