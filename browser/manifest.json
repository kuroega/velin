{
  "manifest_version": 3,
  "name": "Open in Velin",
  "version": "0.2.0",
  "description": "Open the current page, media, or link in the Velin Windows player.",
  "permissions": ["contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Open in Velin" }
}
