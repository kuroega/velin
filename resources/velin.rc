#include <windows.h>

1 RT_MANIFEST "velin.manifest"
101 ICON "velin.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Velin contributors\0"
            VALUE "FileDescription", "Velin media player\0"
            VALUE "FileVersion", "0.2.0\0"
            VALUE "InternalName", "velin\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Velin contributors. GPL-3.0-or-later.\0"
            VALUE "OriginalFilename", "velin.exe\0"
            VALUE "ProductName", "Velin\0"
            VALUE "ProductVersion", "0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

